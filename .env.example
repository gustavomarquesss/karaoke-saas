# Porta da API
PORT=3001
# Pasta onde ficam as músicas processadas
DATA_DIR=./data

# Python do worker (venv criado por scripts/setup)
# Windows: worker/.venv/Scripts/python.exe | Linux/macOS: worker/.venv/bin/python
WORKER_PYTHON=worker/.venv/Scripts/python.exe

# Dispositivo de IA: auto | cuda | mps | cpu
KARAOKE_DEVICE=auto
# Modelo Whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=large-v3
# Precisão: auto | float16 | int8 | float32
WHISPER_COMPUTE_TYPE=auto
# Caso queira forçar o idioma (pt, en...). Vazio = detectar automaticamente
LYRICS_LANGUAGE=
# Quantas músicas processar ao mesmo tempo (GPU única: deixe 1)
JOB_CONCURRENCY=1
